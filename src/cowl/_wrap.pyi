    def object(self) -> Individual: ...

class NegativeObjectPropertyAssertion(Axiom):
    def __init__(
        self,
        prop: ObjectPropertyExpression,
        subj: Individual,
        obj: Individual,
        annotations: Iterable[Annotation] | None = None,
    ) -> None: ...
    def __invert__(self) -> ObjectPropertyAssertion: ...
    def prop(self) -> ObjectPropertyExpression: ...
    def subject(self) -> Individual: ...
    def object(self) -> Individual: ...

class DataPropertyAssertion(Axiom):
    def __init__(
        self,
        prop: DataProperty,
        subj: Individual,
        value: Literal,
        annotations: Iterable[Annotation] | None = None,
    ) -> None: ...
    def __invert__(self) -> NegativeDataPropertyAssertion: ...
    def prop(self) -> DataProperty: ...
    def subject(self) -> Individual: ...
    def value(self) -> Literal: ...

class NegativeDataPropertyAssertion(Axiom):
    def __init__(
        self,
        prop: DataProperty,
        subj: Individual,
        value: Literal,
        annotations: Iterable[Annotation] | None = None,
    ) -> None: ...
    def __invert__(self) -> DataPropertyAssertion: ...
    def prop(self) -> DataProperty: ...
    def subject(self) -> Individual: ...
    def value(self) -> Literal: ...

class AnnotationAssertion(Axiom):
