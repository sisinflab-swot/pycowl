class ObjectPropertyAssertion(Axiom):
    def __init__(
        self,
        prop: ObjectPropertyExpression,
        subj: Individual,
        obj: Individual,
        annotations: Iterable[Annotation] | None = None,
    ) -> None: ...
    def __invert__(self) -> NegativeObjectPropertyAssertion: ...
    def prop(self) -> ObjectPropertyExpression: ...
