    ) -> None: ...
    def prop(self) -> ObjectPropertyExpression: ...

class TransitiveObjectProperty(Axiom):
    def __init__(
        self,
        prop: ObjectPropertyExpression,
        annotations: Iterable[Annotation] | None = None,
    ) -> None: ...
    def prop(self) -> ObjectPropertyExpression: ...

class SubDataPropertyOf(Axiom):
    def __init__(
        self,
        child: DataProperty,
        parent: DataProperty,
        annotations: Iterable[Annotation] | None = None,
    ) -> None: ...
    def child(self) -> DataProperty: ...
